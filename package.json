{
	"name": "@jarvis394/html-svelte-parser",
	"description": "HTML to Svelte parser.",
	"version": "1.1.1",
	"license": "AGPL-3.0-only",
	"author": {
		"name": "Vladislav Ekushev",
		"url": "https://yekushev.dev/"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jarvis394/html-svelte-parser.git"
	},
	"bugs": {
		"url": "https://github.com/jarvis394/html-svelte-parser/issues"
	},
	"keywords": [
		"svelte",
		"svelte-parser",
		"html-svelte-parser",
		"html-to-svelte"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepare": "pnpm package",
		"prepublishOnly": "pnpm package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "playwright test -c playwright.config.ts"
	},
	"exports": {
		"./Html.svelte": {
			"types": "./dist/Html.svelte.d.ts",
			"svelte": "./dist/Html.svelte",
			"default": "./dist/Html.svelte"
		},
		"./Renderer.svelte": {
			"types": "./dist/Renderer.svelte.d.ts",
			"svelte": "./dist/Renderer.svelte",
			"default": "./dist/Renderer.svelte"
		},
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./load": {
			"types": "./dist/load.d.ts",
			"default": "./dist/load.js"
		},
		"./parse": {
			"types": "./dist/parse.d.ts",
			"default": "./dist/parse.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		}
	},
	"typesVersions": {
		">4.0": {
			"Html.svelte": [
				"./dist/Html.svelte.d.ts"
			],
			"Renderer.svelte": [
				"./dist/Renderer.svelte.d.ts"
			],
			"index.d.ts": [
				"./dist/index.d.ts"
			],
			"load": [
				"./dist/load.d.ts"
			],
			"parse": [
				"./dist/parse.d.ts"
			],
			"types": [
				"./dist/types.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^3.47.0 || ^4.0.0 || ^5.0.0"
	},
	"devDependencies": {
		"@playwright/experimental-ct-svelte": "^1.58.2",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.58.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/eslint": "8.56.0",
		"@types/node": "^20.10.8",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^3.17.1",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.5.1",
		"publint": "^0.1.9",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.6",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^8.0.10"
	},
	"dependencies": {
		"dom-serializer": "^3.0.0",
		"domhandler": "^6.0.1",
		"esm-env": "^1.2.2",
		"html-dom-parser": "^7.0.1",
		"htmlparser2": "12.0.0"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
